# Server Port
PORT=5000

# Groq API Configuration
# Get your free key at: https://console.groq.com/keys (No credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model
# Default: llama-3.3-70b-versatile (high quality, fast inference)
# Fallback: llama-3.1-8b-instant (use if you encounter free-tier 70B rate limits)
GROQ_MODEL=llama-3.3-70b-versatile
