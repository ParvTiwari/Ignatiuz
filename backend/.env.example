# Server Port
PORT=5000

# Groq API Configuration
# Get your free key at: https://console.groq.com/keys (No credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model
# Default: openai/gpt-oss-120b (high quality, fast inference)
# Fast / Fallback: openai/gpt-oss-20b (use if you encounter rate limits)
GROQ_MODEL=openai/gpt-oss-120b
